---
/**
 * Componente de Branding para la vista de Acceso
 */
---

<div
  class="flex flex-col items-center lg:items-start text-center lg:text-left lg:max-w-[36rem] w-full"
  aria-labelledby="main-title"
>
  <h1 id="main-title" class="sr-only">
    Observatorio de Responsabilidad Social y Sostenibilidad
  </h1>

  <!-- Logotipo Principal -->
  <div
    class="w-full flex justify-center lg:justify-start animate-rise"
    style="animation-delay: 0.1s"
  >
    <img
      src="/logo observatorio RS.png"
      alt="Observatorio de Responsabilidad Social y Sostenibilidad"
      class="w-full max-w-[310px] sm:max-w-[370px] lg:max-w-[410px] h-auto object-contain transition-transform duration-300 hover:scale-[1.01] select-none"
    />
  </div>

  <!-- Línea decorativa de acento -->
  <div
    class="h-[3px] w-16 rounded-full bg-gradient-to-r from-[#0064c1] via-[#4fa3ff] to-transparent animate-rise mx-auto lg:mx-0 mt-7 mb-6"
    style="animation-delay: 0.2s"
    aria-hidden="true"
  ></div>

  <!-- Texto descriptivo institucional -->
  <p
    class="m-0 max-w-[44ch] text-[#1c2e42] text-[clamp(1.02rem,1.25vw,1.18rem)] leading-[1.7] font-normal tracking-[-0.012em] animate-rise"
    style="animation-delay: 0.28s"
  >
    El{" "}
    <strong class="font-semibold text-[#0a1e36]"
      >Observatorio de Responsabilidad Social y Sostenibilidad</strong
    >{" "}
    es una plataforma de conocimiento y aprendizaje sobre temas de
    responsabilidad social y sostenibilidad.
  </p>
</div>
