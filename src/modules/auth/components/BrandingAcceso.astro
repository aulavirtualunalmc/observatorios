---
/**
 * Componente de Branding para la vista de Acceso
 * Card de pintura simple, sin bordes, con margen respecto a los bordes de la pantalla.
 * - Fundido suave entre obras (sin zoom)
 * - Logo sobre una cápsula blanca, texto sobre un degradado solo abajo
 * - Puntos de navegación y flechas simples
 */
---

<section
  id="branding-art-card"
  class="absolute inset-0 z-0 isolate overflow-hidden bg-slate-300 select-none"
  aria-labelledby="main-title"
>
  <h1 id="main-title" class="sr-only">
    Observatorio de Responsabilidad Social y Sostenibilidad
  </h1>

  <img
    src="/Imagen1.jpeg"
    alt="Pintura de paisaje montañoso y amanecer por Alba"
    class="art-slide is-active"
  />
  <img
    src="/Imagen2.jpeg"
    alt="Pintura de humedal y selva tropical por Alba"
    class="art-slide"
  />

  <div class="art-shade" aria-hidden="true"></div>
</section>

<style>
  .art-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.4s ease-in-out;
  }
  .art-slide.is-active {
    opacity: 1;
  }

  .art-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 45% 60% at 82% 55%,
        rgba(6, 18, 36, 0.62) 0%,
        rgba(6, 18, 36, 0.35) 55%,
        rgba(6, 18, 36, 0) 100%
      ),
      linear-gradient(to top, rgba(6, 18, 36, 0.45) 0%, rgba(6, 18, 36, 0) 50%);
  }

  .art-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: width 0.4s ease, background 0.4s ease;
  }
  .art-dot[aria-selected="true"] {
    width: 26px;
    background: #fff;
  }

  .art-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: transparent;
    cursor: pointer;
    transition: background 0.2s;
  }
  .art-arrow:hover { background: rgba(255, 255, 255, 0.2); }
</style>

<script>
  function setupDirectArtCard() {
    const card = document.getElementById("branding-art-card");
    if (!card) return;

    const slides = Array.from(card.querySelectorAll<HTMLImageElement>(".art-slide"));
    const dots = Array.from(card.querySelectorAll<HTMLButtonElement>(".art-dot"));
    const prevBtn = card.querySelector<HTMLButtonElement>(".btn-art-prev");
    const nextBtn = card.querySelector<HTMLButtonElement>(".btn-art-next");

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | undefined;
    let isPaused = false;
    const INTERVAL = 7000;

    const showSlide = (targetIndex: number) => {
      currentIndex = (targetIndex + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === currentIndex);
      });
      dots.forEach((dot, i) => {
        dot.setAttribute("aria-selected", i === currentIndex ? "true" : "false");
      });
    };

    const startTimer = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        if (!isPaused) showSlide(currentIndex + 1);
      }, INTERVAL);
    };

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        showSlide(Number(dot.dataset.index));
        startTimer();
      });
    });

    prevBtn?.addEventListener("click", () => {
      showSlide(currentIndex - 1);
      startTimer();
    });

    nextBtn?.addEventListener("click", () => {
      showSlide(currentIndex + 1);
      startTimer();
    });

    card.addEventListener("mouseenter", () => {
      isPaused = true;
      card.classList.add("is-paused");
    });

    card.addEventListener("mouseleave", () => {
      isPaused = false;
      card.classList.remove("is-paused");
    });

    startTimer();
  }

  setupDirectArtCard();
  document.addEventListener("astro:page-load", setupDirectArtCard);
</script>
