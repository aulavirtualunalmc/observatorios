---
import type { DocumentoRepositorio } from "../services/repositorio.types";
import SkyShader from "../../../components/SkyShader.astro";
import {
  AltArrowLeftIcon,
  FileTextIcon,
  StarsMinimalisticIcon,
  BookBookmarkIcon,
  NotesIcon,
  CopyIcon,
  CheckCircleIcon,
  GlobeIcon,
  LinkRoundIcon,
} from "@solar-icons/react/outline";

interface Props {
  documento: DocumentoRepositorio;
}

const { documento } = Astro.props;

// Obtener inicial para los avatares de autor
const obtenerInicial = (nombre: string) => {
  return nombre.trim().charAt(0).toUpperCase();
};

const enlaces =
  documento.paginasWeb && documento.paginasWeb.length > 0
    ? documento.paginasWeb
    : documento.enlaceDocumento
    ? [documento.enlaceDocumento]
    : [];
---

<div class="relative flex-1 flex flex-col w-full animate-rise isolate overflow-x-clip bg-[#fbfbfa]">
  <!-- Atmósfera superior con SkyShader -->
  <div
    class="absolute inset-x-0 top-0 h-[380px] -z-10 overflow-hidden pointer-events-none"
    style="mask-image: linear-gradient(180deg, black 0%, black 50%, transparent 100%); -webkit-mask-image: linear-gradient(180deg, black 0%, black 50%, transparent 100%);"
  >
    <SkyShader intensity="soft" />
  </div>

  <div class="flex-1 flex flex-col px-6 md:px-12 pt-8 md:pt-10 pb-16 max-w-7xl w-full mx-auto gap-7">
    <!-- Botón Volver al Repositorio -->
    <div class="flex items-center">
      <a
        href="/dashboard/repositorio"
        class="group inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold text-[#0064c1] bg-white/95 backdrop-blur-md border border-white/80 shadow-[0_2px_12px_-2px_rgba(0,100,193,0.12)] hover:border-[#0064c1]/30 hover:shadow-[0_4px_16px_-2px_rgba(0,100,193,0.22)] transition-all duration-200 active:scale-95 cursor-pointer"
      >
        <AltArrowLeftIcon
          size={15}
          strokeWidth={2.5}
          className="transition-transform duration-200 group-hover:-translate-x-1"
        />
        <span>Volver al repositorio</span>
      </a>
    </div>

    <!-- Header Principal de la Ficha del Documento -->
    <header class="flex flex-col gap-4 pb-6 border-b border-black/[0.06]">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span
            class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl text-white shadow-sm"
            style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
          >
            <FileTextIcon size={20} strokeWidth={1.8} />
          </span>
          <div class="flex flex-col">
            <span class="text-[0.66rem] font-bold uppercase tracking-[0.16em] text-[#0064c1]">
              Documento Consultado
            </span>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-xs font-semibold text-[#787774]">
                {documento.lineaInvestigacion}
              </span>
              {
                documento.categoria && (
                  <span class="text-[0.68rem] font-bold text-[#0064c1] bg-[#0064c1]/10 px-2.5 py-0.5 rounded-full">
                    {documento.categoria}
                  </span>
                )
              }
            </div>
          </div>
        </div>

        <!-- Badge de año y tipo de fuente -->
        <div class="flex items-center gap-2">
          <span
            class="font-mono text-xs font-bold text-[#0064c1] bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/90 shadow-xs"
          >
            {documento.ano}
          </span>
        </div>
      </div>

      <div class="flex flex-col gap-1.5 mt-1">
        <span class="text-[0.7rem] font-bold uppercase tracking-wider text-[#787774]">
          {documento.tipoFuente}
        </span>
        <h1
          class="m-0 text-[clamp(1.75rem,2.8vw,2.35rem)] font-bold text-[#0a0a0a] tracking-[-0.03em] leading-tight mix-blend-multiply opacity-95"
        >
          {documento.titulo}
        </h1>
        <p class="m-0 text-xs md:text-sm text-[#787774] font-medium tracking-tight">
          Ficha de lectura técnica con datos esenciales, autores y referencia de esta investigación.
        </p>
      </div>
    </header>

    <!-- Layout Dividido: Columna Izquierda (Resumen & APA & Páginas Web) + Columna Derecha (Ficha Técnica & Autores) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 md:gap-8 items-start">
      <!-- Columna Principal (8 columnas) -->
      <div class="lg:col-span-8 flex flex-col gap-6">
        <!-- Box Resumen del Documento (Lectura Rápida) -->
        <div
          class="relative flex flex-col gap-3.5 p-6 md:p-7 rounded-[26px] bg-white/95 backdrop-blur-md border border-white/90 shadow-[0_16px_36px_-16px_rgba(9,60,120,0.12),0_1px_2px_rgba(0,0,0,0.03)] overflow-hidden"
        >
          <!-- Glow superior azul -->
          <div class="absolute inset-x-8 top-0 h-[2px] bg-gradient-to-r from-transparent via-[#0064c1]/40 to-transparent pointer-events-none" />

          <div class="flex items-center gap-2.5">
            <span
              class="grid h-8 w-8 place-items-center rounded-xl text-white shadow-xs"
              style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
            >
              <StarsMinimalisticIcon size={16} strokeWidth={2} />
            </span>
            <div class="flex flex-col">
              <span class="text-[0.64rem] font-bold uppercase tracking-[0.16em] text-[#0064c1]">
                Lectura Rápida
              </span>
              <h3 class="m-0 text-sm md:text-base font-bold text-[#0a0a0a] tracking-tight">
                Resumen del documento
              </h3>
            </div>
          </div>

          <p class="m-0 text-xs md:text-[0.88rem] text-[#2f3437] leading-relaxed font-normal">
            {documento.resumen || "Sin resumen disponible para este documento."}
          </p>
        </div>

        <!-- Box Páginas Web / Enlaces Disponibles -->
        {
          enlaces.length > 0 && (
            <div class="flex flex-col gap-3 p-5 md:p-6 rounded-[24px] bg-white/95 backdrop-blur-md border border-white/90 shadow-[0_12px_28px_-12px_rgba(9,60,120,0.08)]">
              <div class="flex items-center gap-2 text-xs font-bold text-[#0a0a0a]">
                <span class="grid h-6 w-6 place-items-center rounded-lg bg-[#0064c1]/10 text-[#0064c1] text-[0.68rem] font-mono font-bold">
                  <GlobeIcon size={13} />
                </span>
                <span class="uppercase tracking-wider text-[0.72rem] text-[#787774]">
                  Páginas Web y Fuentes Digitales ({enlaces.length})
                </span>
              </div>

              <div class="flex flex-wrap gap-2 pt-1">
                {enlaces.map((enlace) => (
                  <a
                    href={enlace}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/link inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-black/[0.02] hover:bg-[#0064c1]/10 border border-black/[0.06] hover:border-[#0064c1]/30 text-xs font-medium text-[#0064c1] transition-all shadow-2xs cursor-pointer max-w-full"
                  >
                    <LinkRoundIcon size={14} className="shrink-0 text-[#0064c1]" />
                    <span class="truncate max-w-[320px] font-mono text-[0.75rem]">{enlace}</span>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Box Referencia APA con botón para copiar -->
        <div class="flex flex-col gap-3 p-5 md:p-6 rounded-[24px] bg-white/95 backdrop-blur-md border border-white/90 shadow-[0_12px_28px_-12px_rgba(9,60,120,0.08)]">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="grid h-6 w-6 place-items-center rounded-lg bg-[#0064c1]/10 text-[#0064c1] text-[0.68rem] font-mono font-bold">
                <BookBookmarkIcon size={13} />
              </span>
              <span class="uppercase tracking-wider text-[0.72rem] font-bold text-[#787774]">Referencia APA</span>
            </div>

            {
              documento.referenciaApa && (
                <button
                  type="button"
                  id="btn-copiar-apa"
                  data-texto={documento.referenciaApa}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-[#0064c1] bg-[#0064c1]/10 hover:bg-[#0064c1]/20 transition-all cursor-pointer active:scale-95"
                >
                  <CopyIcon size={13} id="icono-copiar-apa" />
                  <span id="texto-copiar-apa">Copiar APA</span>
                </button>
              )
            }
          </div>

          <div class="relative p-4 rounded-xl bg-black/[0.02] border border-black/[0.04]">
            <p class="m-0 text-xs md:text-[0.84rem] text-[#2f3437] leading-relaxed italic font-serif">
              {documento.referenciaApa || "Referencia en formato APA no disponible."}
            </p>
          </div>
        </div>
      </div>

      <!-- Columna Lateral: Ficha Técnica y Autores (4 columnas) -->
      <aside class="lg:col-span-4 flex flex-col gap-5 p-6 rounded-[26px] bg-white/95 backdrop-blur-md border border-white/90 shadow-[0_16px_36px_-16px_rgba(9,60,120,0.12),0_1px_2px_rgba(0,0,0,0.03)]">
        <!-- Encabezado de Ficha Técnica -->
        <div class="flex items-center justify-between pb-3 border-b border-black/[0.06]">
          <div class="flex flex-col">
            <span class="text-[0.64rem] font-bold uppercase tracking-[0.16em] text-[#0064c1]">
              Ficha Técnica
            </span>
            <h3 class="m-0 text-sm font-bold text-[#0a0a0a]">
              Datos del documento
            </h3>
          </div>
        </div>

        <!-- Tabla de Datos -->
        <div class="flex flex-col divide-y divide-black/[0.05] text-xs">
          <div class="flex items-center justify-between py-2.5">
            <span class="text-[#787774] font-medium">Año</span>
            <span class="font-bold text-[#0a0a0a] font-mono">{documento.ano}</span>
          </div>

          <div class="flex items-center justify-between py-2.5">
            <span class="text-[#787774] font-medium">País</span>
            <span class="font-bold text-[#0a0a0a]">{documento.pais}</span>
          </div>

          {
            documento.categoria && (
              <div class="flex items-center justify-between py-2.5">
                <span class="text-[#787774] font-medium">Categoría</span>
                <span class="font-bold text-[#0064c1]">{documento.categoria}</span>
              </div>
            )
          }

          <div class="flex flex-col gap-1 py-2.5">
            <span class="text-[#787774] font-medium">Tipo de fuente</span>
            <span class="font-bold text-[#0a0a0a]">{documento.tipoFuente}</span>
          </div>
        </div>

        <!-- Sección de Autores -->
        <div class="flex flex-col gap-3 pt-2 border-t border-black/[0.06]">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-[#0a0a0a]">Autores</span>
            <span class="font-mono text-[#787774] font-semibold">{documento.autores.length}</span>
          </div>

          <div class="flex flex-col gap-2">
            {
              documento.autores.map((autor) => (
                <div class="flex items-center gap-2.5 p-2 rounded-xl bg-black/[0.02]">
                  <span
                    class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-white text-[0.68rem] font-bold shadow-xs"
                    style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb);"
                  >
                    {obtenerInicial(autor)}
                  </span>
                  <span class="text-xs text-[#2f3437] font-medium truncate">
                    {autor}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>

<script>
  function setupDetalleDocumento() {
    const btnCopiar = document.getElementById("btn-copiar-apa") as HTMLButtonElement | null;
    const textoBtn = document.getElementById("texto-copiar-apa");

    if (btnCopiar && textoBtn) {
      btnCopiar.onclick = async () => {
        const texto = btnCopiar.getAttribute("data-texto") || "";
        if (!texto) return;

        try {
          await navigator.clipboard.writeText(texto);
          textoBtn.textContent = "¡Copiado!";
          btnCopiar.classList.add("bg-emerald-500/10", "text-emerald-600");
          btnCopiar.classList.remove("text-[#0064c1]", "bg-[#0064c1]/10");

          setTimeout(() => {
            textoBtn.textContent = "Copiar APA";
            btnCopiar.classList.remove("bg-emerald-500/10", "text-emerald-600");
            btnCopiar.classList.add("text-[#0064c1]", "bg-[#0064c1]/10");
          }, 2000);
        } catch {
          // Fallback silencioso
        }
      };
    }
  }

  document.addEventListener("DOMContentLoaded", setupDetalleDocumento);
  document.addEventListener("astro:page-load", setupDetalleDocumento);
</script>
