---
import type { ItemYoutubeFeed } from "../services/dashboard.types";
import {
  VideocameraIcon,
  ArrowRightIcon,
  AltArrowLeftIcon,
  AltArrowRightIcon,
  PlayIcon,
  AddCircleIcon,
} from "@solar-icons/react/outline";

interface Props {
  videos: ItemYoutubeFeed[];
}

const { videos = [] } = Astro.props;
const items = videos.slice(0, 6);
const carouselId = "youtube-feed-carousel";
---

<div
  class="relative flex flex-col w-full group/carousel select-none"
  id={carouselId}
  data-total={items.length}
>
  <!-- Header del Carrusel -->
  <div class="flex items-center justify-between gap-3 pb-3 mb-1">
    <div class="flex items-center gap-2.5">
      <span
        class="grid h-9 w-9 place-items-center rounded-xl text-white shadow-sm shrink-0"
        style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
      >
        <VideocameraIcon size={18} strokeWidth={1.8} />
      </span>
      <div class="flex flex-col">
        <span
          class="text-[0.62rem] font-bold uppercase tracking-[0.16em] text-[#0064c1]"
        >
          Para ver y aprender
        </span>
        <h3 class="m-0 text-base font-bold text-[#0a0a0a] tracking-tight">
          YouTube Feed
        </h3>
      </div>
    </div>

    <!-- Controles Prev / Next en el Header -->
    {
      items.length > 1 && (
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="btn-carousel-prev grid h-7 w-7 place-items-center rounded-full bg-white/90 hover:bg-[#0064c1]/10 text-[#787774] hover:text-[#0064c1] shadow-xs border border-black/[0.06] hover:border-[#0064c1]/30 transition-all cursor-pointer active:scale-95"
            aria-label="Video anterior"
          >
            <AltArrowLeftIcon size={14} strokeWidth={2.2} />
          </button>
          <button
            type="button"
            class="btn-carousel-next grid h-7 w-7 place-items-center rounded-full bg-white/90 hover:bg-[#0064c1]/10 text-[#787774] hover:text-[#0064c1] shadow-xs border border-black/[0.06] hover:border-[#0064c1]/30 transition-all cursor-pointer active:scale-95"
            aria-label="Siguiente video"
          >
            <AltArrowRightIcon size={14} strokeWidth={2.2} />
          </button>
        </div>
      )
    }
  </div>

  <!-- Contenedor del Carrusel -->
  {
    items.length === 0 ? (
      <div class="flex flex-col items-center justify-center p-8 rounded-[24px] bg-white/80 border border-white/80 shadow-sm text-center gap-2.5">
        <div class="grid h-10 w-10 place-items-center rounded-xl bg-[#0064c1]/10 text-[#0064c1]">
          <VideocameraIcon size={20} strokeWidth={1.5} />
        </div>
        <div class="flex flex-col gap-0.5">
          <h4 class="m-0 text-xs font-bold text-[#0a0a0a]">No hay videos en el feed</h4>
          <p class="m-0 text-[0.72rem] text-[#787774]">Los videos de YouTube que publiques aparecerán aquí.</p>
        </div>
        <a
          href="/dashboard/contenido-feed/nuevo"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-[#0064c1] bg-[#0064c1]/10 hover:bg-[#0064c1]/15 transition-all mt-1"
        >
          <AddCircleIcon size={13} strokeWidth={2} />
          <span>Cargar video</span>
        </a>
      </div>
    ) : (
      <div class="relative w-full overflow-hidden rounded-[22px]">
        <div
          class="carousel-track flex w-full transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]"
          style="transform: translateX(0%);"
        >
          {items.map((item) => (
            <div class="w-full shrink-0">
              <div class="relative w-full min-h-[335px] sm:min-h-[345px] bg-white/95 backdrop-blur-md rounded-[22px] border border-black/[0.08] p-4 sm:p-5 flex flex-col justify-between shadow-[0_12px_32px_-8px_rgba(9,60,120,0.12),0_1px_2px_rgba(0,0,0,0.04)] overflow-hidden">
                <!-- Efecto glow superior sutil -->
                <div class="absolute inset-x-6 top-0 h-[2px] bg-gradient-to-r from-transparent via-[#0064c1]/40 to-transparent pointer-events-none" />

                <!-- Contenido Superior -->
                <div class="flex flex-col gap-2.5">
                  <div class="flex items-center justify-between gap-2 text-[0.68rem] font-medium text-[#787774]">
                    <span class="truncate">{item.canal || "YouTube"}</span>
                    {item.duracion && (
                      <span class="font-mono text-[0.66rem] text-[#787774] bg-black/[0.04] px-1.5 py-0.5 rounded">
                        {item.duracion}
                      </span>
                    )}
                  </div>

                  <!-- Miniatura Video con Botón Play Trigger -->
                  <a
                    href={`/dashboard/youtube/${item.id}`}
                    class="relative w-full h-34 sm:h-38 overflow-hidden rounded-xl bg-zinc-900 shadow-xs group/thumb block"
                    title={`Ver ${item.titulo}`}
                  >
                    {item.imagenMiniatura ? (
                      <img
                        src={item.imagenMiniatura}
                        alt={item.titulo}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover/thumb:scale-105 opacity-90"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full grid place-items-center bg-zinc-800 text-white">
                        <VideocameraIcon size={24} />
                      </div>
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent pointer-events-none" />

                    <div class="absolute inset-0 grid place-items-center pointer-events-none">
                      <div
                        class="grid h-9 w-9 place-items-center rounded-full text-white shadow-lg backdrop-blur-xs transition-transform duration-300 group-hover/thumb:scale-110"
                        style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
                      >
                        <PlayIcon size={15} strokeWidth={2} />
                      </div>
                    </div>
                  </a>

                  <!-- Título y Descripción -->
                  <div class="flex flex-col gap-1">
                    <a
                      href={`/dashboard/youtube/${item.id}`}
                      class="m-0 text-[0.88rem] sm:text-[0.92rem] font-bold text-[#0a0a0a] hover:text-[#0064c1] transition-colors tracking-tight leading-snug line-clamp-2 no-underline"
                    >
                      {item.titulo}
                    </a>
                    <p class="m-0 text-[0.74rem] text-[#2f3437] leading-relaxed line-clamp-2">
                      {item.descripcion}
                    </p>
                  </div>
                </div>

                <!-- Botón de acción al pie -->
                <div class="pt-2.5 border-t border-black/[0.05] flex items-center justify-end mt-auto">
                  <a
                    href={`/dashboard/youtube/${item.id}`}
                    class="btn-ver-video relative inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-full text-white text-xs font-semibold tracking-[-0.01em] transition-all duration-200 active:scale-95 shadow-sm cursor-pointer"
                    style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
                  >
                    <PlayIcon size={13} strokeWidth={2} />
                    <span class="relative z-10">Ver video</span>
                    <ArrowRightIcon size={12} strokeWidth={2} />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <!-- Footer con Puntos Indicadores -->
  {
    items.length > 1 && (
      <div class="flex items-center justify-center gap-1.5 mt-3">
        {items.map((_, idx) => (
          <button
            type="button"
            class="carousel-dot h-1.5 rounded-full transition-all duration-400 cursor-pointer border-none p-0"
            data-dot-index={idx}
            style={
              idx === 0
                ? "width: 22px; background-color: #0064c1;"
                : "width: 6px; background-color: rgba(0, 0, 0, 0.2);"
            }
            aria-label={`Ir al slide ${idx + 1}`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  let ytAutoPlayTimer: ReturnType<typeof setInterval> | null = null;

  function initYoutubeCarousel() {
    if (ytAutoPlayTimer) {
      clearInterval(ytAutoPlayTimer);
      ytAutoPlayTimer = null;
    }

    const container = document.getElementById("youtube-feed-carousel");
    if (!container) return;

    const track = container.querySelector<HTMLElement>(".carousel-track");
    const dots = container.querySelectorAll<HTMLButtonElement>(".carousel-dot");
    const prevBtn = container.querySelector<HTMLButtonElement>(".btn-carousel-prev");
    const nextBtn = container.querySelector<HTMLButtonElement>(".btn-carousel-next");
    const total = parseInt(container.getAttribute("data-total") || "0", 10);

    if (track && total > 1) {
      let activeIndex = 0;
      let isPaused = false;

      const updateSlide = (targetIndex: number) => {
        activeIndex = (targetIndex + total) % total;
        track.style.transform = `translateX(-${activeIndex * 100}%)`;

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.style.width = "22px";
            dot.style.backgroundColor = "#0064c1";
          } else {
            dot.style.width = "6px";
            dot.style.backgroundColor = "rgba(0, 0, 0, 0.2)";
          }
        });
      };

      const nextSlide = () => {
        updateSlide(activeIndex + 1);
      };

      const startAutoplay = () => {
        if (ytAutoPlayTimer) clearInterval(ytAutoPlayTimer);
        ytAutoPlayTimer = setInterval(() => {
          if (!isPaused) {
            nextSlide();
          }
        }, 6000);
      };

      const resetAutoplay = () => {
        startAutoplay();
      };

      dots.forEach((dot, idx) => {
        dot.addEventListener("click", () => {
          updateSlide(idx);
          resetAutoplay();
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener("click", () => {
          updateSlide(activeIndex - 1);
          resetAutoplay();
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener("click", () => {
          updateSlide(activeIndex + 1);
          resetAutoplay();
        });
      }

      // Pausar en hover para interacción cómoda
      container.addEventListener("mouseenter", () => {
        isPaused = true;
      });
      container.addEventListener("mouseleave", () => {
        isPaused = false;
      });

      // Soporte swipe
      let touchStartX = 0;
      let touchEndX = 0;

      container.addEventListener("touchstart", (e) => {
        touchStartX = e.changedTouches[0].screenX;
        isPaused = true;
      }, { passive: true });

      container.addEventListener("touchend", (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchEndX - touchStartX;
        if (Math.abs(diffX) > 35) {
          if (diffX < 0) {
            updateSlide(activeIndex + 1);
          } else {
            updateSlide(activeIndex - 1);
          }
          resetAutoplay();
        }
        isPaused = false;
      }, { passive: true });

      startAutoplay();
    }
  }

  initYoutubeCarousel();
  document.addEventListener("astro:page-load", initYoutubeCarousel);
  document.addEventListener("astro:before-swap", () => {
    if (ytAutoPlayTimer) {
      clearInterval(ytAutoPlayTimer);
      ytAutoPlayTimer = null;
    }
  });
</script>
