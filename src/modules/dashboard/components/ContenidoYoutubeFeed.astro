---
import SkyShader from "../../../components/SkyShader.astro";
import { ServicioDashboard } from "../services/dashboard.service";
import {
  VideocameraIcon,
  PlayIcon,
  ClockCircleIcon,
  ArrowRightIcon,
  AltArrowLeftIcon,
  AltArrowRightIcon,
  RoundedMagnifierZoomInIcon,
  AddCircleIcon,
} from "@solar-icons/react/outline";

const datos = await ServicioDashboard.obtenerDatosHome();
const videos = datos.videos || [];
---

<div class="relative flex-1 flex flex-col w-full animate-rise isolate overflow-x-clip">
  <!-- Atmósfera superior con SkyShader y degradado -->
  <div
    class="absolute inset-x-0 top-0 h-[360px] -z-10 overflow-hidden pointer-events-none"
    style="mask-image: linear-gradient(180deg, black 0%, black 45%, transparent 100%); -webkit-mask-image: linear-gradient(180deg, black 0%, black 45%, transparent 100%);"
  >
    <SkyShader intensity="soft" />
  </div>

  <div class="flex-1 flex flex-col px-6 md:px-12 pt-10 md:pt-14 pb-16 max-w-7xl w-full mx-auto gap-8">
    <!-- Encabezado de Youtube Feed -->
    <header class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-black/[0.06]">
      <div class="flex flex-col gap-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-[#0064c1]">
          <span class="h-2 w-2 rounded-full bg-[#0064c1] animate-pulse"></span>
          Recursos Multimedia &amp; Aprendizaje
        </div>

        <h1 class="m-0 text-[clamp(2rem,3.4vw,2.8rem)] font-bold text-[#0a0a0a] tracking-[-0.035em] leading-[1.08] mix-blend-multiply opacity-95">
          Youtube Feed
        </h1>

        <p class="m-0 text-base text-[#0a0a0a]/75 font-medium tracking-tight">
          Documentales, video reportajes y recursos audiovisuales públicos de Youtube sobre temas del repositorio.
        </p>
      </div>

      <!-- Buscador -->
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-full border border-white/80 shadow-[0_4px_16px_-4px_rgba(9,60,120,0.1)] focus-within:border-[#0064c1]/40 focus-within:shadow-[0_4px_20px_-2px_rgba(0,100,193,0.18)] transition-all">
          <RoundedMagnifierZoomInIcon size={16} className="text-[#787774] shrink-0" />
          <input
            id="buscador-videos"
            type="text"
            placeholder="Buscar videos..."
            class="bg-transparent border-none outline-none text-xs font-medium text-[#0a0a0a] placeholder:text-[#787774] w-36 sm:w-56"
          />
        </div>
      </div>
    </header>

    <!-- Grid de Videos o Empty State -->
    {
      videos.length === 0 ? (
        <div class="flex flex-col items-center justify-center p-12 sm:p-16 rounded-[32px] bg-white/95 border border-white/80 shadow-[0_20px_45px_-18px_rgba(9,60,120,0.14),0_1px_3px_rgba(0,0,0,0.03)] backdrop-blur-md text-center max-w-md mx-auto w-full gap-4 animate-rise">
          <div class="grid h-16 w-16 place-items-center rounded-2xl bg-[#0064c1]/10 text-[#0064c1]">
            <VideocameraIcon size={32} strokeWidth={1.5} />
          </div>

          <div class="flex flex-col gap-1.5">
            <h3 class="m-0 text-lg font-bold text-[#0a0a0a]">No hay videos publicados</h3>
            <p class="m-0 text-xs text-[#787774] leading-relaxed">
              Actualmente no se encuentran videos registrados. Puedes agregar nuevos enlaces de YouTube desde el panel de Contenido Feed.
            </p>
          </div>

          <a
            href="/dashboard/contenido-feed/nuevo"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-white text-xs font-semibold tracking-tight shadow-sm transition-all duration-300 active:scale-95 cursor-pointer mt-2"
            style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
          >
            <AddCircleIcon size={16} strokeWidth={2} />
            <span>Cargar primer video</span>
          </a>
        </div>
      ) : (
        <div class="flex flex-col gap-8">
          <div id="grid-videos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
            {videos.map((item) => (
              <article
                class="articulo-video group relative flex flex-col justify-between rounded-[22px] bg-white/95 border border-white/80 shadow-[0_14px_35px_-16px_rgba(9,60,120,0.14),0_1px_3px_rgba(0,0,0,0.03)] backdrop-blur-md overflow-hidden transition-all duration-300 hover:shadow-[0_18px_40px_-12px_rgba(9,60,120,0.2)] hover:-translate-y-0.5"
                data-card-id={item.id}
                data-texto={`${item.titulo} ${item.descripcion} ${item.canal} ${item.etiqueta}`.toLowerCase()}
              >
                <!-- Portada con Imagen Miniatura y Enlace a la Página del Video -->
                {item.imagenMiniatura ? (
                  <a
                    href={`/dashboard/youtube/${item.id}`}
                    class="relative w-full h-38 sm:h-42 overflow-hidden bg-black/5 block group/thumb"
                    title={`Ver ${item.titulo}`}
                  >
                    <img
                      src={item.imagenMiniatura}
                      alt={item.titulo}
                      class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/thumb:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent pointer-events-none" />

                    <!-- Badges superiores -->
                    <div class="absolute top-2.5 inset-x-2.5 flex items-center justify-between gap-1.5 pointer-events-none">
                      <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="inline-flex items-center gap-1 text-[0.65rem] text-[#0064c1] font-bold uppercase tracking-wider bg-white/95 backdrop-blur-md px-2.5 py-0.5 rounded-full shadow-xs">
                          <VideocameraIcon size={11} strokeWidth={2} />
                          {item.etiqueta}
                        </span>
                        {item.destacado && (
                          <span class="inline-flex items-center gap-1 text-[0.62rem] text-amber-800 font-bold uppercase tracking-wider bg-amber-400/90 backdrop-blur-md px-2 py-0.5 rounded-full shadow-xs">
                            ★ Destacado
                          </span>
                        )}
                      </div>

                      {item.canal && (
                        <span class="inline-flex items-center gap-1 text-[0.65rem] text-white font-medium bg-black/60 backdrop-blur-md px-2.5 py-0.5 rounded-full border border-white/20">
                          {item.canal}
                        </span>
                      )}
                    </div>

                    <!-- Botón Play Central Azul Institucional -->
                    <div class="absolute inset-0 grid place-items-center pointer-events-none">
                      <div
                        class="grid h-10 w-10 place-items-center rounded-full text-white shadow-lg backdrop-blur-xs transition-transform duration-300 group-hover/thumb:scale-115"
                        style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
                      >
                        <PlayIcon size={18} strokeWidth={2} />
                      </div>
                    </div>
                  </a>
                ) : (
                  <a
                    href={`/dashboard/youtube/${item.id}`}
                    class="relative w-full h-20 bg-gradient-to-r from-[#0064c1]/10 to-[#4fa3ff]/10 p-3.5 flex items-center justify-between block"
                    title={`Ver ${item.titulo}`}
                  >
                    <span class="inline-flex items-center gap-1 text-[0.65rem] text-[#0064c1] font-bold uppercase tracking-wider bg-white/95 px-2 py-0.5 rounded-full shadow-xs">
                      {item.etiqueta}
                    </span>
                    <span class="text-[0.72rem] font-semibold text-[#787774]">{item.canal}</span>
                  </a>
                )}

                <!-- Cuerpo del Video -->
                <div class="flex flex-col flex-1 p-4 sm:p-5 justify-between gap-3">
                  <div class="flex flex-col gap-1.5">
                    <div class="flex items-center gap-2 text-[0.72rem] font-semibold text-[#787774]">
                      <span>{item.canal}</span>
                      {item.duracion && (
                        <>
                          <span>•</span>
                          <span class="flex items-center gap-1 text-[0.68rem]">
                            <ClockCircleIcon size={11} strokeWidth={1.5} />
                            {item.duracion}
                          </span>
                        </>
                      )}
                    </div>

                    <a
                      href={`/dashboard/youtube/${item.id}`}
                      class="m-0 text-sm sm:text-[0.96rem] font-bold text-[#0a0a0a] tracking-tight leading-snug group-hover:text-[#0064c1] transition-colors duration-300 line-clamp-2 no-underline"
                    >
                      {item.titulo}
                    </a>

                    <p class="m-0 text-[0.78rem] text-[#2f3437]/85 leading-relaxed line-clamp-2">
                      {item.descripcion}
                    </p>
                  </div>

                  <!-- Botón de Ver video a la página interna -->
                  <div class="pt-3 border-t border-black/[0.06] mt-auto flex items-center">
                    <a
                      href={`/dashboard/youtube/${item.id}`}
                      class="group/btn relative w-full inline-flex items-center justify-center gap-1.5 h-8.5 px-3 rounded-full text-white text-[0.76rem] font-semibold tracking-[-0.01em] cursor-pointer overflow-hidden transition-all duration-300 active:scale-[0.985] shadow-xs"
                      style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
                    >
                      <PlayIcon size={13} strokeWidth={2} />
                      <span>Ver video</span>
                      <ArrowRightIcon
                        size={13}
                        strokeWidth={2}
                        className="transition-transform duration-300 group-hover/btn:translate-x-0.5 ml-0.5"
                      />
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Mensaje Sin Resultados -->
          <div
            id="mensaje-sin-videos"
            class="hidden flex-col items-center justify-center p-12 rounded-[28px] bg-white/95 border border-white/80 shadow-[0_20px_45px_-18px_rgba(9,60,120,0.14)] text-center max-w-md mx-auto w-full gap-2 animate-rise"
          >
            <div class="grid h-12 w-12 place-items-center rounded-2xl bg-[#0064c1]/10 text-[#0064c1]">
              <RoundedMagnifierZoomInIcon size={24} />
            </div>
            <h3 class="m-0 text-base font-bold text-[#0a0a0a]">No se encontraron videos</h3>
            <p class="m-0 text-xs text-[#787774]">
              Intenta buscar con otros términos clave.
            </p>
          </div>

          <!-- Controles de Paginación Elegante (hasta 9 por página) -->
          <div
            id="contenedor-paginacion-yt"
            class="hidden flex-col sm:flex-row items-center justify-between gap-4 pt-6 pb-2 border-t border-black/[0.06]"
          >
            <div class="text-xs text-[#787774] font-medium" id="info-paginacion-yt">
              Mostrando <span id="pag-desde-yt" class="font-bold text-[#0a0a0a]">1</span> - <span id="pag-hasta-yt" class="font-bold text-[#0a0a0a]">9</span> de <span id="pag-total-yt" class="font-bold text-[#0a0a0a]">0</span> videos
            </div>

            <div class="flex items-center gap-1.5" id="controles-paginacion-yt">
              <button
                type="button"
                id="btn-pag-prev-yt"
                class="inline-flex items-center gap-1.5 h-8 px-3.5 rounded-full text-xs font-semibold bg-white/95 hover:bg-white text-[#2f3437] hover:text-[#0064c1] border border-black/[0.08] hover:border-[#0064c1]/30 shadow-xs transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-[#2f3437] disabled:hover:border-black/[0.08] active:scale-95"
                aria-label="Página anterior"
              >
                <AltArrowLeftIcon size={14} strokeWidth={2.2} />
                <span>Anterior</span>
              </button>

              <div id="numeros-paginacion-yt" class="flex items-center gap-1">
                <!-- Se generan dinámicamente con JS -->
              </div>

              <button
                type="button"
                id="btn-pag-next-yt"
                class="inline-flex items-center gap-1.5 h-8 px-3.5 rounded-full text-xs font-semibold bg-white/95 hover:bg-white text-[#2f3437] hover:text-[#0064c1] border border-black/[0.08] hover:border-[#0064c1]/30 shadow-xs transition-all cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-[#2f3437] disabled:hover:border-black/[0.08] active:scale-95"
                aria-label="Página siguiente"
              >
                <span>Siguiente</span>
                <AltArrowRightIcon size={14} strokeWidth={2.2} />
              </button>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Estilos de botones de número de página */
  :global(.btn-num-pag-yt) {
    display: inline-grid;
    place-items: center;
    height: 32px;
    min-width: 32px;
    padding: 0 6px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-family: monospace;
    font-weight: 600;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  :global(.btn-num-pag-yt.activo) {
    color: #ffffff !important;
    font-weight: 700 !important;
    background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb);
    box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);
    border: none;
    cursor: default;
  }
  :global(.btn-num-pag-yt:not(.activo)) {
    background-color: rgba(255, 255, 255, 0.95);
    color: #2f3437;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }
  :global(.btn-num-pag-yt:not(.activo):hover) {
    background-color: #ffffff;
    color: #0064c1;
    border-color: rgba(0, 100, 193, 0.35);
  }
</style>

<script>
  function setupYoutubeFeed() {
    const inputBuscador = document.getElementById("buscador-videos") as HTMLInputElement | null;
    const articulos = document.querySelectorAll<HTMLElement>(".articulo-video");
    const mensajeSinVideos = document.getElementById("mensaje-sin-videos");

    // Elementos de Paginación
    const contenedorPaginacion = document.getElementById("contenedor-paginacion-yt");
    const pagDesde = document.getElementById("pag-desde-yt");
    const pagHasta = document.getElementById("pag-hasta-yt");
    const pagTotal = document.getElementById("pag-total-yt");
    const btnPagPrev = document.getElementById("btn-pag-prev-yt") as HTMLButtonElement | null;
    const btnPagNext = document.getElementById("btn-pag-next-yt") as HTMLButtonElement | null;
    const numerosPaginacion = document.getElementById("numeros-paginacion-yt");

    const ITEMS_POR_PAGINA = 9;
    let paginaActual = 1;

    const filtrarVideos = (scrollArriba = false) => {
      const termino = (inputBuscador?.value || "").toLowerCase().trim();
      const articulosCoincidentes: HTMLElement[] = [];

      articulos.forEach((articulo) => {
        const texto = articulo.getAttribute("data-texto") || "";
        if (!termino || texto.includes(termino)) {
          articulosCoincidentes.push(articulo);
        } else {
          articulo.style.display = "none";
        }
      });

      const totalCoincidentes = articulosCoincidentes.length;
      const totalPaginas = Math.ceil(totalCoincidentes / ITEMS_POR_PAGINA) || 1;

      if (paginaActual > totalPaginas) paginaActual = totalPaginas;
      if (paginaActual < 1) paginaActual = 1;

      const inicio = (paginaActual - 1) * ITEMS_POR_PAGINA;
      const fin = Math.min(inicio + ITEMS_POR_PAGINA, totalCoincidentes);

      articulosCoincidentes.forEach((articulo, index) => {
        if (index >= inicio && index < fin) {
          articulo.style.display = "";
        } else {
          articulo.style.display = "none";
        }
      });

      if (mensajeSinVideos) {
        if (totalCoincidentes === 0) {
          mensajeSinVideos.classList.remove("hidden");
          mensajeSinVideos.classList.add("flex");
        } else {
          mensajeSinVideos.classList.add("hidden");
          mensajeSinVideos.classList.remove("flex");
        }
      }

      if (contenedorPaginacion) {
        if (totalCoincidentes === 0) {
          contenedorPaginacion.classList.add("hidden");
          contenedorPaginacion.classList.remove("flex");
        } else {
          contenedorPaginacion.classList.remove("hidden");
          contenedorPaginacion.classList.add("flex");

          if (pagDesde) pagDesde.textContent = totalCoincidentes > 0 ? (inicio + 1).toString() : "0";
          if (pagHasta) pagHasta.textContent = fin.toString();
          if (pagTotal) pagTotal.textContent = totalCoincidentes.toString();

          if (btnPagPrev) btnPagPrev.disabled = paginaActual <= 1;
          if (btnPagNext) btnPagNext.disabled = paginaActual >= totalPaginas;

          if (numerosPaginacion) {
            numerosPaginacion.innerHTML = "";
            for (let i = 1; i <= totalPaginas; i++) {
              const btnNum = document.createElement("button");
              btnNum.type = "button";
              btnNum.className = `btn-num-pag-yt ${i === paginaActual ? "activo" : ""}`;
              btnNum.textContent = i.toString();
              btnNum.setAttribute("aria-label", `Página ${i}`);

              btnNum.onclick = () => {
                if (i !== paginaActual) {
                  paginaActual = i;
                  filtrarVideos(true);
                }
              };
              numerosPaginacion.appendChild(btnNum);
            }
          }
        }
      }

      if (scrollArriba) {
        const grid = document.getElementById("grid-videos");
        if (grid) {
          grid.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
    };

    if (inputBuscador) {
      inputBuscador.addEventListener("input", () => {
        paginaActual = 1;
        filtrarVideos();
      });
    }

    if (btnPagPrev) {
      btnPagPrev.onclick = () => {
        if (paginaActual > 1) {
          paginaActual--;
          filtrarVideos(true);
        }
      };
    }

    if (btnPagNext) {
      btnPagNext.onclick = () => {
        const termino = (inputBuscador?.value || "").toLowerCase().trim();
        const totalCoincidentes = Array.from(articulos).filter((art) => {
          const texto = art.getAttribute("data-texto") || "";
          return !termino || texto.includes(termino);
        }).length;
        const totalPaginas = Math.ceil(totalCoincidentes / ITEMS_POR_PAGINA) || 1;

        if (paginaActual < totalPaginas) {
          paginaActual++;
          filtrarVideos(true);
        }
      };
    }

    // Inicializar primera página
    filtrarVideos();
  }

  document.addEventListener("DOMContentLoaded", setupYoutubeFeed);
  document.addEventListener("astro:page-load", setupYoutubeFeed);
</script>
