---
import SkyShader from "../../../components/SkyShader.astro";
import type { ItemYoutubeFeed } from "../services/dashboard.types";
import {
  AltArrowLeftIcon,
  VideocameraIcon,
  ClockCircleIcon,
  LinkRoundIcon,
  StarsMinimalisticIcon,
  PlayIcon,
} from "@solar-icons/react/outline";

interface Props {
  video: ItemYoutubeFeed;
  otrosVideos?: ItemYoutubeFeed[];
}

const { video, otrosVideos = [] } = Astro.props;
const videosRecomendados = otrosVideos.slice(0, 3);

// Extraer ID del video de YouTube
function extraerVideoId(url: string): string {
  if (!url) return "";
  const matchWatch = url.match(/[?&]v=([^&]+)/);
  if (matchWatch) return matchWatch[1];
  const matchShort = url.match(/youtu\.be\/([^?&/]+)/);
  if (matchShort) return matchShort[1];
  const matchShorts = url.match(/youtube\.com\/shorts\/([^?&/]+)/);
  if (matchShorts) return matchShorts[1];
  const matchEmbed = url.match(/embed\/([^?&/]+)/);
  if (matchEmbed) return matchEmbed[1];
  return "";
}

const videoId = extraerVideoId(video.enlace);
---

<div class="relative flex-1 flex flex-col w-full animate-rise isolate overflow-x-clip">
  <!-- Atmósfera superior con SkyShader y degradado -->
  <div
    class="absolute inset-x-0 top-0 h-[420px] -z-10 overflow-hidden pointer-events-none"
    style="mask-image: linear-gradient(180deg, black 0%, black 50%, transparent 100%); -webkit-mask-image: linear-gradient(180deg, black 0%, black 50%, transparent 100%);"
  >
    <SkyShader intensity="soft" />
  </div>

  <div class="flex-1 flex flex-col px-6 md:px-12 pt-8 md:pt-10 pb-16 max-w-6xl w-full mx-auto gap-8">
    <!-- Botón Volver y Categoría -->
    <div class="flex items-center justify-between gap-4">
      <a
        href="/dashboard/youtube"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold text-[#2f3437] hover:text-[#0064c1] bg-white/90 hover:bg-white border border-black/[0.08] hover:border-[#0064c1]/30 shadow-xs backdrop-blur-md transition-all duration-200 active:scale-95"
      >
        <AltArrowLeftIcon size={15} strokeWidth={2.5} />
        <span>Volver al YouTube Feed</span>
      </a>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs text-[#0064c1] font-bold uppercase tracking-wider bg-white/95 backdrop-blur-md px-3 py-1 rounded-full border border-white/80 shadow-xs">
          <VideocameraIcon size={13} strokeWidth={2} />
          {video.etiqueta}
        </span>
        {video.destacado && (
          <span class="inline-flex items-center gap-1 text-[0.68rem] text-amber-800 font-bold uppercase tracking-wider bg-amber-400/90 backdrop-blur-md px-2.5 py-1 rounded-full shadow-xs">
            <StarsMinimalisticIcon size={12} strokeWidth={2} />
            Destacado
          </span>
        )}
      </div>
    </div>

    <!-- Contenedor Principal: Reproductor de Video en Pantalla Completa -->
    <div class="flex flex-col gap-6">
      <div class="rounded-[28px] bg-white/95 border border-white/80 shadow-[0_25px_60px_-18px_rgba(9,60,120,0.18),0_1px_3px_rgba(0,0,0,0.03)] backdrop-blur-md overflow-hidden p-3 sm:p-5">
        <!-- Contenedor del Reproductor con Detección Automática de Restricción -->
        <div
          id="contenedor-reproductor"
          class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black shadow-inner"
          data-video-id={videoId}
          data-video-url={video.enlace}
        >
          <!-- Iframe inicial generado por la API de YouTube -->
          <div id="player-youtube-iframe" class="w-full h-full"></div>

          <!-- Fallback limpio y minimalista -->
          <div
            id="fallback-error-video"
            class="hidden absolute inset-0 z-20 flex-col items-center justify-center p-6 sm:p-8 text-center bg-zinc-950/95 text-white gap-3 animate-rise"
          >
            {video.imagenMiniatura && (
              <img
                src={video.imagenMiniatura}
                alt=""
                class="absolute inset-0 w-full h-full object-cover opacity-20 blur-md pointer-events-none"
              />
            )}
            <div class="absolute inset-0 bg-black/40 pointer-events-none" />

            <div class="relative z-10 grid h-12 w-12 place-items-center rounded-full bg-white/10 text-white/90 backdrop-blur-xs shadow-sm">
              <PlayIcon size={22} strokeWidth={2} />
            </div>

            <div class="relative z-10 flex flex-col gap-1.5 max-w-sm">
              <h3 class="m-0 text-base sm:text-lg font-bold text-white tracking-tight">
                Reproducción no disponible aquí
              </h3>
              <p class="m-0 text-xs sm:text-sm text-white/75 leading-relaxed">
                Para reproducir el video abre el link que sale abajo de <span class="text-sky-400 font-semibold">Ver en YouTube Oficial</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Información Inmediata del Video -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-5 pb-2 px-2 sm:px-3">
          <div class="flex flex-col gap-1.5 max-w-3xl">
            <h1 class="m-0 text-xl sm:text-2xl md:text-[1.7rem] font-bold text-[#0a0a0a] tracking-tight leading-tight">
              {video.titulo}
            </h1>

            <div class="flex items-center gap-3 text-xs font-semibold text-[#787774] flex-wrap">
              <span class="text-[#0a0a0a] font-bold">{video.canal}</span>
              {video.duracion && (
                <>
                  <span>•</span>
                  <span class="flex items-center gap-1">
                    <ClockCircleIcon size={13} strokeWidth={1.8} />
                    {video.duracion}
                  </span>
                </>
              )}
            </div>
          </div>

          <!-- Botón de apertura externa en YouTube -->
          <a
            id="btn-abrir-youtube-oficial"
            href={video.enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-white text-xs font-semibold tracking-tight shadow-sm transition-all duration-300 active:scale-95 cursor-pointer shrink-0"
            style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
          >
            <span>Ver en YouTube Oficial</span>
            <LinkRoundIcon size={15} strokeWidth={2} />
          </a>
        </div>
      </div>

      <!-- Descripción Detallada -->
      {video.descripcion && (
        <div class="rounded-[24px] bg-white/90 border border-white/80 p-6 sm:p-7 shadow-[0_12px_32px_-12px_rgba(9,60,120,0.1)] backdrop-blur-md flex flex-col gap-3">
          <h3 class="m-0 text-sm font-bold uppercase tracking-wider text-[#0064c1]">
            Acerca de este recurso
          </h3>
          <p class="m-0 text-sm text-[#2f3437] leading-relaxed whitespace-pre-line">
            {video.descripcion}
          </p>
        </div>
      )}

      <!-- Otros Videos Sugeridos / Relacionados (Máximo 3) -->
      {videosRecomendados.length > 0 && (
        <div class="flex flex-col gap-4 mt-4">
          <div class="flex items-center justify-between">
            <h3 class="m-0 text-lg font-bold text-[#0a0a0a] tracking-tight">
              Otros videos recomendados
            </h3>
            <a
              href="/dashboard/youtube"
              class="text-xs font-bold text-[#0064c1] hover:underline"
            >
              Ver todos →
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
            {videosRecomendados.map((sug) => (
              <a
                href={`/dashboard/youtube/${sug.id}`}
                class="group flex flex-col justify-between rounded-[20px] bg-white/95 border border-white/80 shadow-[0_12px_30px_-14px_rgba(9,60,120,0.12)] p-4 gap-3 transition-all duration-300 hover:shadow-[0_16px_36px_-10px_rgba(9,60,120,0.2)] hover:-translate-y-0.5"
              >
                <div class="relative w-full h-32 rounded-xl overflow-hidden bg-black/5">
                  {sug.imagenMiniatura ? (
                    <img
                      src={sug.imagenMiniatura}
                      alt={sug.titulo}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full grid place-items-center bg-zinc-800 text-white">
                      <VideocameraIcon size={20} />
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none" />
                  <div class="absolute inset-0 grid place-items-center pointer-events-none">
                    <div class="grid h-8 w-8 place-items-center rounded-full bg-white/90 text-[#0064c1] shadow-md group-hover:scale-110 transition-transform">
                      <PlayIcon size={14} strokeWidth={2} />
                    </div>
                  </div>
                </div>

                <div class="flex flex-col gap-1">
                  <span class="text-[0.68rem] font-bold text-[#0064c1] uppercase">{sug.canal}</span>
                  <h4 class="m-0 text-xs font-bold text-[#0a0a0a] line-clamp-2 group-hover:text-[#0064c1] transition-colors">
                    {sug.titulo}
                  </h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  function initYouTubePlayer() {
    const contenedor = document.getElementById("contenedor-reproductor");
    if (!contenedor) return;

    const videoId = contenedor.getAttribute("data-video-id");
    const videoUrl = contenedor.getAttribute("data-video-url") || "";
    const fallback = document.getElementById("fallback-error-video");
    const playerDiv = document.getElementById("player-youtube-iframe");

    function mostrarFallback() {
      if (playerDiv) playerDiv.style.display = "none";
      if (fallback) {
        fallback.classList.remove("hidden");
        fallback.classList.add("flex");
      }
    }

    if (!videoId) {
      mostrarFallback();
      return;
    }

    // Inicializar reproductor con API de YouTube para capturar restricciones de inserción (errores 101, 150, 100, 2, 5)
    const crearReproductor = () => {
      const win = window as any;
      if (win.YT && win.YT.Player) {
        try {
          new win.YT.Player("player-youtube-iframe", {
            videoId: videoId,
            playerVars: {
              autoplay: 1,
              rel: 0,
              modestbranding: 1,
              playsinline: 1,
              origin: window.location.origin,
            },
            events: {
              onError: (event: any) => {
                // Errores 101/150: Bloqueado por el propietario en sitios externos
                // Errores 100/2/5: Eliminado, privado o no soportado
                console.warn("YouTube Player error:", event?.data);
                mostrarFallback();
              },
            },
          });
        } catch (err) {
          console.error("Error al instanciar YT.Player:", err);
          mostrarFallback();
        }
      }
    };

    if (window.YT && window.YT.Player) {
      crearReproductor();
    } else {
      const prevOnReady = (window as any).onYouTubeIframeAPIReady;
      (window as any).onYouTubeIframeAPIReady = () => {
        if (typeof prevOnReady === "function") prevOnReady();
        crearReproductor();
      };

      if (!document.getElementById("yt-iframe-api-script")) {
        const tag = document.createElement("script");
        tag.id = "yt-iframe-api-script";
        tag.src = "https://www.youtube.com/iframe_api";
        const firstScript = document.getElementsByTagName("script")[0];
        firstScript?.parentNode?.insertBefore(tag, firstScript);
      }
    }
  }

  initYouTubePlayer();
  document.addEventListener("astro:page-load", initYouTubePlayer);
</script>
