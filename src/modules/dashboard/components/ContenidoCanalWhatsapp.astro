---
import SkyShader from "../../../components/SkyShader.astro";
import {
  LinkIcon,
  AltArrowRightIcon,
  CheckCircleIcon,
  CopyIcon,
} from "@solar-icons/react/outline";

const whatsappChannelUrl =
  "https://www.whatsapp.com/channel/0029VbAjBq68Pgs8CW3qp23N";
---

<div
  class="relative flex-1 flex flex-col w-full animate-rise isolate overflow-x-clip"
>
  <!-- Atmósfera superior con SkyShader -->
  <div
    class="absolute inset-x-0 top-0 h-[360px] -z-10 overflow-hidden pointer-events-none"
    style="mask-image: linear-gradient(180deg, black 0%, black 50%, transparent 100%); -webkit-mask-image: linear-gradient(180deg, black 0%, black 50%, transparent 100%);"
  >
    <SkyShader intensity="soft" />
  </div>

  <div
    class="flex-1 flex flex-col px-6 md:px-12 pt-10 md:pt-14 pb-16 max-w-4xl w-full mx-auto gap-8"
  >
    <!-- Encabezado de la página -->
    <header
      class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-black/[0.06]"
    >
      <div class="flex flex-col gap-2 max-w-2xl">
        <h1
          class="m-0 text-[clamp(2rem,3.4vw,2.8rem)] font-bold text-[#0a0a0a] tracking-[-0.035em] leading-[1.08] mix-blend-multiply opacity-95"
        >
          Canal de WhatsApp
        </h1>

        <p class="m-0 text-base text-[#0a0a0a]/75 font-medium tracking-tight">
          Sigue nuestro canal para estar al tanto de todas las novedades del
          Observatorio.
        </p>
      </div>
    </header>

    <!-- Tarjeta Principal del Canal -->
    <div
      class="relative w-full rounded-[24px] bg-white/95 backdrop-blur-md border border-black/[0.08] p-6 sm:p-8 shadow-[0_16px_40px_-16px_rgba(9,60,120,0.1),0_1px_2px_rgba(0,0,0,0.04)] overflow-hidden flex flex-col gap-6"
    >
      <!-- Fila superior de información del canal -->
      <div
        class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5"
      >
        <div class="flex items-center gap-4">
          <!-- Logo / Icono WhatsApp -->
          <div
            class="relative grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-tr from-[#25D366] to-[#128C7E] text-white shadow-[0_6px_16px_-3px_rgba(37,211,102,0.4)] shrink-0"
          >
            <svg class="h-8 w-8 fill-current" viewBox="0 0 24 24">
              <path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
              ></path>
            </svg>
          </div>

          <div class="flex flex-col">
            <div class="flex items-center gap-1.5">
              <h2
                class="m-0 text-lg sm:text-xl font-bold text-[#0a0a0a] tracking-tight"
              >
                Observatorio RS &amp; Sostenibilidad
              </h2>
              <CheckCircleIcon
                size={18}
                strokeWidth={2.2}
                className="text-[#25D366] shrink-0"
              />
            </div>
            <span class="text-xs text-[#787774] font-medium"
              >Canal de WhatsApp</span
            >
          </div>
        </div>
      </div>

      <!-- Enlace y Botones -->
      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 p-3.5 rounded-xl bg-black/[0.03] border border-black/[0.05]"
      >
        <div
          class="flex items-center gap-2 overflow-hidden px-1 text-xs sm:text-sm text-[#2f3437] font-mono"
        >
          <LinkIcon
            size={16}
            strokeWidth={2}
            className="text-[#787774] shrink-0"
          />
          <span class="truncate">{whatsappChannelUrl}</span>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            id="btn-copiar-enlace"
            data-url={whatsappChannelUrl}
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg bg-white hover:bg-black/5 text-[#2f3437] text-xs font-semibold border border-black/10 shadow-2xs transition-all active:scale-95 cursor-pointer"
          >
            <CopyIcon size={14} strokeWidth={2} />
            <span id="texto-btn-copiar">Copiar</span>
          </button>

          <a
            href={whatsappChannelUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-white text-xs font-semibold bg-[#25D366] hover:bg-[#20bd5a] active:scale-95 transition-all no-underline shadow-xs"
          >
            <span>Abrir canal</span>
            <AltArrowRightIcon size={14} strokeWidth={2.4} />
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupWhatsappCopy() {
    const btnCopiar = document.getElementById("btn-copiar-enlace");
    const textoBtn = document.getElementById("texto-btn-copiar");
    if (!btnCopiar || !textoBtn) return;

    btnCopiar.addEventListener("click", async () => {
      const url = btnCopiar.getAttribute("data-url") || "";
      try {
        await navigator.clipboard.writeText(url);
        textoBtn.textContent = "¡Copiado!";
        setTimeout(() => {
          textoBtn.textContent = "Copiar";
        }, 2000);
      } catch {
        window.open(url, "_blank");
      }
    });
  }

  setupWhatsappCopy();
  document.addEventListener("astro:page-load", setupWhatsappCopy);
</script>
