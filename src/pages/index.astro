---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import FormToasts from "../components/FormToasts.tsx";
import { BrandingAcceso, CardAcceso } from "../modules/auth";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Acceso y registro al Observatorio de Responsabilidad Social y Sostenibilidad"
    />
    <title>Observatorio · Acceso</title>
    <link rel="icon" type="image/png" href="/logo observatorio RS.png" />
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <main class="relative w-full min-h-svh isolate overflow-x-clip">
      <!-- Branding del Dominio Auth: pintura a pantalla completa como fondo -->
      <BrandingAcceso />

      <!-- Tarjeta de Acceso del Dominio Auth: compacta y translúcida sobre la pintura -->
      <div
        class="relative z-10 w-full min-h-svh flex flex-col gap-5 items-center justify-center lg:items-end px-4 py-8 sm:px-6 lg:px-[clamp(2rem,7vw,7rem)]"
      >
        <p
          class="order-first lg:order-none lg:absolute lg:left-[clamp(2rem,7vw,7rem)] lg:bottom-[clamp(2rem,6vh,4rem)] m-0 max-w-[20rem] text-center lg:text-left text-sm md:text-base leading-[1.4] text-white [text-shadow:0_2px_16px_rgba(6,18,36,0.55)]"
        >
          El <strong class="font-semibold">Observatorio de Responsabilidad Social y Sostenibilidad</strong>
          es una plataforma de conocimiento y aprendizaje sobre temas de responsabilidad social y sostenibilidad.
        </p>
        <CardAcceso />
      </div>

      <FormToasts
        client:load
        formId="form-login"
        successTitle="Sesión iniciada"
        successDescription="Bienvenido al Observatorio."
        redirectUrl="/dashboard"
      />
    </main>
  </body>
</html>
