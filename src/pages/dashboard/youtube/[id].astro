---
export const prerender = false;

import "../../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../../components/Sidebar.astro";
import {
  DetalleVideoYoutube,
  ServicioDashboard,
} from "../../../modules/dashboard";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/dashboard/youtube");
}

const videoData = await ServicioDashboard.obtenerVideoPorId(id);

if (!videoData) {
  return Astro.redirect("/dashboard/youtube");
}

// Obtener otros videos para recomendaciones
const datosHome = await ServicioDashboard.obtenerDatosHome();
const otrosVideos = (datosHome.videos || [])
  .filter((v) => v.id !== id)
  .slice(0, 3);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`Visualización del recurso: ${videoData.titulo}`}
    />
    <title>{videoData.titulo} · YouTube Feed · Observatorio</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral de navegación con YouTube Feed activo -->
      <Sidebar active="Youtube Feed" />

      <!-- Contenido de la Pantalla del Video -->
      <main class="flex-1 flex flex-col min-w-0">
        <DetalleVideoYoutube video={videoData} otrosVideos={otrosVideos} />
      </main>
    </div>
  </body>
</html>
